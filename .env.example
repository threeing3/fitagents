# AI Fitness Coach Agent local configuration
# Copy to .env and fill the key matching LLM_PROVIDER when you want live model calls.

PROJECT_NAME=ai-fitness-coach-agent
VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL + pgvector
DB_USER=fitness
DB_PASSWORD=change-me
DB_NAME=ai_fitness_agent
DATABASE_URL=postgresql+psycopg://fitness:${DB_PASSWORD}@localhost:4553/ai_fitness_agent
VECTOR_DIMENSION=1024
USE_PGVECTOR=true

# Production scaling knobs
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_PLAN=10/minute
RATE_LIMIT_NUTRITION=8/minute
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_AUTH_REGISTER=5/hour
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
BACKGROUND_TASK_MAX_ATTEMPTS=3

# Model provider abstraction
LLM_PROVIDER=qwen
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_API_KEY=
EMBEDDING_PROVIDER=qwen

# Future provider switches
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ai-fitness-coach
LANGSMITH_API_KEY=

# Authentication, public demo, and cost controls
# Production must replace every placeholder and set AUTH_COOKIE_SECURE=true.
JWT_SECRET_KEY=change-me-in-production-use-a-random-64-char-string
JWT_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=ai_fitness_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
INVITE_CODE=
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=
DAILY_MODEL_CALL_LIMIT=20
GLOBAL_DAILY_MODEL_LIMIT=500
METRICS_TOKEN=
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=25000000

# Optional phase-4 adapter comparison service
ADAPTER_INFERENCE_URL=
ADAPTER_INFERENCE_KEY=

# Local frontend
CORS_ORIGINS=http://localhost:5173
